rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDriver() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/config/app).data.driverUid == request.auth.uid;
    }

    // Holds { driverUid, driverName, driverPhone, driverVehicle, driverPlate,
    // driverHeadline, driverBio }. Public read so the client can check "is
    // this signed-in user the driver", and so the marketing site can render
    // the driver's public bio. The driver can edit their own profile fields
    // from the dashboard, but never their own driverUid (that stays
    // console-only, set once when the driver first signs up).
    match /config/{docId} {
      allow read: if true;
      allow update: if isDriver() &&
        request.resource.data.driverUid == resource.data.driverUid;
      allow create, delete: if false;
    }

    match /bookings/{bookingId} {
      // Guests can request a ride without signing in.
      allow create: if true;
      // A customer can read their own bookings; the driver can read all.
      allow read: if isDriver() ||
        (isSignedIn() && resource.data.customerUid == request.auth.uid);
      // Only the driver can confirm/decline/mark paid.
      allow update: if isDriver() ||
        // ...except the customer cancelling their own still-pending request.
        (isSignedIn() && resource.data.customerUid == request.auth.uid &&
          resource.data.status == 'REQUESTED' &&
          request.resource.data.status == 'CANCELLED');
      allow delete: if false;
    }

    // Index of every generated invoice/receipt PDF (bookingRef, customer
    // name/phone, amount, url) so the driver console can search/re-download
    // them later — the only durable record a manual walk-in receipt gets.
    // Written by whichever browser (guest customer or driver) generates a
    // document, same trust model as creating a booking. Only the driver can
    // browse the index back.
    match /documents/{docId} {
      allow create, update: if true;
      allow read: if isDriver();
      allow delete: if false;
    }

    // One-time "confirm your information" profile, set after email OTP
    // verification. A customer can only see/write their own.
    match /customers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Short-lived OTP codes for email verification. Same rule: only the
    // owning user can read or write their own code.
    match /otps/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
